    "聚焦核查": {
      "required_payload": [
        "company"
      ],
      "required_sections": [
        {
          "aliases": [
            "聚焦核查",
            "Focused Review"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "情景、红旗与尽调清单"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "分层结论与下一动作",
            "初步建议：推进 / 条件推进 / 暂缓 / 放弃"
          ],
          "min_chars": 20,
