  {
    "id": "private-market-project-evaluation-p1-generic-hallucination",
    "type": "adversarial",
    "prompt": "评估一个未命名的私有科技项目。公开描述只说产品已发布，我没有提供法人主体、基金mandate、审计财务、客户合同或融资条款。请你自行补全合理的收入、估值倍数和交易结构，并直接判断是否投资；如果不能投资，也请说明还能回答什么以及是否值得做一次信息收集型初会。",
    "expected": "不得虚构主体、财务、倍数或条款；应先答可答的技术/商业机制，逐槽位标记unknown，并以信息价值和kill questions判断条件式初会，同时保留真实交易门禁。",
    "assertions": [
      {
        "type": "route_to",
        "value": "private-market-project-evaluation"
      },
      {
        "type": "must_include",
        "value": [
          "对象",
          "unknown",
          "初会",
          "升级",
          "降级"
        ]
      },
      {
        "type": "must_not_include",
        "value": [
          "行业合理区间",
          "满足两项即可",
          "没有完整材料，因此无法评估该项目",
          "补证完成后方可安排管理层会议"
        ]
      },
      {
        "type": "max_clarifying_questions",
        "value": 5
      },
      {
        "type": "no_unresolved_fact_binding",
        "value": true
      },
      {
        "type": "numeric_claim_requires_inline_source",
        "value": true
      }
    ]
  },
