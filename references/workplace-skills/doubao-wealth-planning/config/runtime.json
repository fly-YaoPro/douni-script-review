          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "目标资金测算与情景"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "资产配置原则与区间"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "行动清单与年度复盘"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "假设、局限和专业咨询事项"
          ],
          "min_chars": 20,
          "fact_binding": false
        }
      ]
    },
    "年度更新": {
      "required_payload": [
        "household",
        "goals",
        "assumptions"
      ],
      "required_sections": [
        {
          "aliases": [
            "家庭财务快照"
          ],
          "min_chars": 20,
