{
  "version": "V3.3-finance-integration",
  "legacy_release_version": 11,
  "case_type": "wealth-planning",
  "state_contract": {
    "field": "artifact_state",
    "transition_gate": "scripts/wealth_runtime_gate.py",
    "allowed_states": [
      "ready",
      "degraded",
      "intake_required",
      "confirmation_required",
      "routed",
      "stopped"
    ]
  },
  "default_delivery_tier": "direct",
  "route_contract": {
    "fields": [
      "selected_skill",
      "intent",
      "route_status"
    ],
    "route_only_no_analysis": true
  },
  "claim_ledger": {
    "required": true,
    "unknown_conservation": true,
    "critical_primary_or_official": true,
    "required_fields": [
      "claim_id",
      "claim",
      "claim_type",
      "critical",
      "object_id",
      "as_of",
      "period",
      "currency",
      "unit",
      "source_ids",
      "source_role",
      "source_tier",
      "confidence",
      "conflict_state"
    ],
    "validator": "scripts/validate_facts.py"
  },
  "artifact_contract": {
    "full": "write_complete_json_with_schema_hash_counts",
    "compact": "core_results_exceptions_unknowns_hard_gates_sources_path",
    "required_artifacts": [
      "report.md",
      "facts.json",
      "report-display.md",
      "report-capabilities.json",
      "report-manifest.json"
    ],
    "validator": "scripts/validate_deliverable.py",
    "verify_exists_and_hash": true
  },
  "finalizer": {
    "type": "source_locked",
    "path": "scripts/finalize_report.py",
    "max_runs": 1,
    "may_add_facts": false,
    "may_add_source_ids": false,
    "failure_state": "degraded"
  },
  "side_effect_policy": {
    "read_compute_draft": "allow",
    "transfer_repay_open_account_purchase": "preview_confirm_permission_audit",
    "permission_gate": "scripts/wealth_runtime_gate.py"
  },
  "default_mode": "auto",
  "modes": {
    "快速体检": {
      "required_payload": [
        "household",
        "cash_flow",
        "assets",
        "liabilities"
      ],
      "required_sections": [
        {
          "aliases": [
            "家庭财务快照"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "现金流、应急资金与债务"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "保障与重大风险"
          ],
          "min_chars": 20,
          "fact_binding": true
